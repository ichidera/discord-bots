# Rename this file to .env and fill in your values.

# Bot token from https://discord.com/developers/applications -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=

# Application (Client) ID from the same "General Information" page
CLIENT_ID=

# Optional: put a server ID here while testing so slash commands register
# instantly in that one server (global commands can take up to 1hr to propagate).
GUILD_ID=
